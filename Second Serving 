// Event Planner
function forecast(){
  var inv = +$("inv").value||0, r = (+$("rsvp").value||0)/100, cpm = +$("cpm").value||0, p = +$("plan-meals").value||0, b = (+$("buf").value||0)/100;
  var att = Math.round(inv * r), rec = Math.ceil(att * (1 + b)), sur = Math.max(0, p - att);
  $("fAtt").textContent = att; $("fRec").textContent = rec; $("fSur").textContent = sur;
  $("fCost").textContent = "₹" + (sur * cpm).toLocaleString();
  $("fSave").textContent = "₹" + (Math.max(0, p - rec) * cpm).toLocaleString();
  var risk = p < att ? "High" : p < rec ? "Medium" : "Low";
  $("fRisk").textContent = risk;
  $("planNote").textContent = p > rec ? "You are cooking "+(p-rec)+" meals above the safety buffer. Cooking "+rec+" meals saves money and prevents waste." : "Plan matches expected attendance.";
  return sur;
}
