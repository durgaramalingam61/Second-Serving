    '<div style="margin:8px 0;font-weight:bold">'+(o.need > 0 ? o.need + ' meals needed today' : 'Fully fulfilled!')+'</div>'+
    '<div class="tags"><span>'+(o.nv?'Accepts Non-Veg':'Veg Only')+'</span>·<span>'+(o.own?'Own Vehicle':'Needs Courier')+'</span></div></div>';
  }).join("");
}
$("fd").onchange = drawNeeds; $("fv").onchange = drawNeeds;

