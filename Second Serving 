function safeMin(){
  if(!S.items.length) return 0;
  var f = +$("store").value;
  return Math.max(0, Math.round(Math.min.apply(null, S.items.map(function(it){ return it.life*f - curAgo(it); }))));
}
function totalLife(){ return Math.min.apply(null, S.items.map(function(it){ return it.life*(+$("store").value); })) || 1; }

// Match Engine
$("go").onclick = function(){
  var rest = S.rests[S.sel];
  if(!rest || !S.items.length) return alert("Add items before matching.");
  var vq = 0, nq = 0;
  S.items.forEach(function(it){ if(it.diet==="veg") vq+=it.qty; else nq+=it.qty; });
  var tot = vq + nq, left = safeMin();
  
  var list = ORGS.map(function(o){
    var d = km(rest, o), t = Math.round(d/22*60 + (o.own?12:22));
    var acc = o.nv ? tot : vq;
    var fit = acc ? Math.min(acc, o.need)/Math.max(acc, o.need) : 0;
    var ok = acc > 0 && o.need > 0 && t + 10 <= left;
    var sc = Math.round((fit*30 + Math.max(0, 1 - d/10)*25 + o.urg/5*20 + Math.max(0, (left-t)/left)*25) * (ok ? 1 : 0.3));
    return {o:o, d:d, t:t, ok:ok, score:sc, acc:acc};
  }).sort(function(a,b){ return b.score - a.score; });

  var vr = vq, nr = nq, alloc = {};
  list.forEach(function(m){
    if(!m.ok) return;
    var g = Math.min(m.o.need, m.o.nv ? vr+nr : vr);
    if(g > 0){ alloc[m.o.id] = g; if(m.o.nv){ var tn = Math.min(nr,g); nr-=tn; vr-=(g-tn); } else { vr-=g; } }
  });

  $("clock").classList.remove("hide");
  $("clockTxt").textContent = left > 0 ? "Safe to consume for another " + Math.floor(left/60) + "h " + (left%60) + "m" : "Expired. Do not donate.";
  $("clockTxt").style.color = left < 45 ? "var(--chili)" : "var(--ok)";
  $("clockBar").style.width = Math.min(100, (left/totalLife())*100) + "%";

  $("matches").innerHTML = list.map(function(m){
    var a = alloc[m.o.id];
    return '<div class="match '+(a?'pick':'')+'"><div class="mh"><b>'+m.o.n+'</b><span class="score">'+m.score+'%</span></div>'+
    '<div class="tags"><span>'+m.o.t+'</span>·<span>'+m.d+' km away</span>·<span>Needs '+m.o.need+' meals</span>·<span>'+(m.o.nv?'Accepts Non-Veg':'Veg Only')+'</span>·<span>'+(m.o.own?'Own vehicle':'Volunteer courier')+'</span></div>'+
    (a ? '<div style="margin-top:8px"><b>Suggested: '+a+' meals</b>. Arrival in ~'+m.t+' min.</div>' : '')+'</div>';
  }).join("");

  var picks = list.filter(function(m){ return alloc[m.o.id]; });
  if(picks.length){
    $("plan-out").innerHTML = '<button class="btn" id="conf">Confirm & Dispatch Pickups</button>';
    $("conf").onclick = function(){
      var ctot = 0;
      picks.forEach(function(m){
        ctot += alloc[m.o.id];
        m.o.need = Math.max(0, m.o.need - alloc[m.o.id]);
        log("Dispatched "+alloc[m.o.id]+" meals to "+m.o.n+" (ETA: "+m.t+"m). PIN: "+Math.floor(1000+Math.random()*9000));
      });
      S.items = []; S.meals += ctot; S.kg += Math.round(ctot*0.4); S.co2 += Math.round(ctot*0.4*2.5);
      $("sMeals").textContent = S.meals; $("sKg").textContent = S.kg; $("sCo2").textContent = S.co2;
      drawItems(); $("plan-out").innerHTML = '<div style="padding:15px;background:var(--surf);border:1px solid var(--ok);color:var(--ok);border-radius:12px;margin-top:12px"><b>'+ctot+' meals rescued!</b> Courier dispatched.</div>';
    };
  }
};

function log(msg){
  var l = $("log"), li = document.createElement("li");
  li.innerHTML = "<time>"+new Date().toLocaleTimeString()+"</time> " + msg;
  l.insertBefore(li, l.firstChild);
}

// NGO Board
function drawNeeds(){
  var fd = $("fd").value, fv = $("fv").value, rest = S.rests[S.sel];
  var fl = ORGS.filter(function(o){
    return (fd==="all"||(fd==="veg"?!o.nv:o.nv)) && (fv==="all"||(fv==="own"?o.own:!o.own));
